@article{SUN2025763,
title = {Financial Transaction Network Risk Prediction Model Based On Graph Neural Network},
journal = {Procedia Computer Science},
volume = {261},
pages = {763-771},
year = {2025},
note = {The 5th International Conference on Machine Learning and Big Data Analytics for IoT Security and Privacy (SPIoT2024)},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2025.04.403},
url = {https://www.sciencedirect.com/science/article/pii/S1877050925015066},
author = {Yuemei Sun},
keywords = {GraphSAG, financial transactions, risk indicators, network subgraph, weighted sampling},
abstract = {To address the risks in financial systems arising from the continuous development of financial markets and the deepening of globalization. First, based on the risk indicator system of the trading market, subgraphs representing the fundamental elements of multidimensional information and risk indicators are determined. For the integrated complex network graph data, an improved node feature embedding method is used for classification, with cosine similarity measuring node attribute similarity. This allows for the extraction of node structural features, which are then concatenated with attribute features. Finally, based on the aggregated features, normalization and a softmax classifier are employed to generate a probability distribution fitting the objective function, improving the overall accuracy of the weighted sampling GraphSAGE financial transaction network risk prediction model. Experimental results show that the loss value of the graph neural network’s cross-entropy loss function is in the low range of 0.15–0.35, and the AUC values for the risks involved in the trading center and the risk indicators faced by traders are 0.8529 and 0.8845, respectively. The classification accuracy of the graph neural network for risk transaction overflow is as high as 99.93%. This validates the effectiveness and feasibility of the proposed financial transaction network risk prediction model, providing new technical means for risk management and development in financial transaction networks.}
}

@article{BITETTO2023101746,
title = {Machine learning and credit risk: Empirical evidence from small- and mid-sized businesses},
journal = {Socio-Economic Planning Sciences},
volume = {90},
pages = {101746},
year = {2023},
issn = {0038-0121},
doi = {https://doi.org/10.1016/j.seps.2023.101746},
url = {https://www.sciencedirect.com/science/article/pii/S0038012123002586},
author = {Alessandro Bitetto and Paola Cerchiello and Stefano Filomeni and Alessandra Tanda and Barbara Tarantino},
keywords = {Credit rating, SMB, Historical random forest, Machine learning, Relationship banking, Invoice lending},
abstract = {In this paper, we compare two different approaches to estimate the credit risk for small- and mid-sized businesses (SMBs), namely a classic parametric approach, by fitting an ordered probit model, and a non-parametric approach, calibrating a machine learning historical random forest (HRF) model. The models are applied to a unique and proprietary dataset comprising granular firm-level quarterly data collected from a European investment bank and an international insurance company on a sample of 464 Italian SMBs over the period 2015–2017. Results show that the HRF approach outperforms the traditional ordered probit model, highlighting how advanced estimation methodologies that use machine learning techniques can be successfully implemented to predict SMB credit risk, i.e. when facing high asymmetries of information. Moreover, by using Shapley values, we are able to assess the relevance of each variable in predicting SMB credit risk.}
}

@article{ZANDI2025586,
title = {Attention-based dynamic multilayer graph neural networks for loan default prediction},
journal = {European Journal of Operational Research},
volume = {321},
number = {2},
pages = {586-599},
year = {2025},
issn = {0377-2217},
doi = {https://doi.org/10.1016/j.ejor.2024.09.025},
url = {https://www.sciencedirect.com/science/article/pii/S0377221724007288},
author = {Sahab Zandi and Kamesh Korangi and María Óskarsdóttir and Christophe Mues and Cristián Bravo},
keywords = {OR in banking, Credit scoring, Dynamic multilayer networks, Graph neural networks, Recurrent neural networks},
abstract = {Whereas traditional credit scoring tends to employ only individual borrower- or loan-level predictors, it has been acknowledged for some time that connections between borrowers may result in default risk propagating over a network. In this paper, we present a model for credit risk assessment leveraging a dynamic multilayer network built from a Graph Neural Network and a Recurrent Neural Network, each layer reflecting a different source of network connection. We test our methodology in a behavioural credit scoring context using a dataset provided by U.S. mortgage financier Freddie Mac, in which different types of connections arise from the geographical location of the borrower and their choice of mortgage provider. The proposed model considers both types of connections and the evolution of these connections over time. We enhance the model by using a custom attention mechanism that weights the different time snapshots according to their importance. After testing multiple configurations, a model with GAT, LSTM, and the attention mechanism provides the best results. Empirical results demonstrate that, when it comes to predicting probability of default for the borrowers, our proposed model brings both better results and novel insights for the analysis of the importance of connections and timestamps, compared to traditional methods.}
}

@article{LIU2025,
title = {Temporal Graph Learning for Default Prediction and Systemic Risk Mitigation in Financial Networks},
journal = {Intelligent Computing},
volume = {4},
year = {2025},
issn = {2771-5892},
doi = {https://doi.org/10.34133/icomputing.0193},
url = {https://www.sciencedirect.com/science/article/pii/S277158922500013X},
author = {Moyang Liu and Taijun Li and Junqi Chen and Zhibin Niu and Jiawan Zhang},
abstract = {In the realm of networked-loans, it is common for small and medium enterprises (SMEs) to obtain bank loans through guarantor companies. However, during economic downturns, the default of a few firms can trigger a cascade effect within the network, potentially resulting in a comprehensive system collapse. When a firm defaults, its guarantor is contractually required to settle the debt, which may strain the guarantor’s financial health and trigger further defaults across connected firms. This cascading effect can transform isolated financial distress into systemic risk. Therefore, the prediction of firms’ defaults from a comprehensive perspective is vital for ensuring the long-term stability of economic growth. To address this challenge, we propose a temporal graph learning framework that integrates macroeconomic trends and a tailored risk matrix, capturing both external shocks and internal contagion risks. Validated on a large commercial bank dataset with a total loan volume of USD 3 trillion, our system risk dynamic prediction (SRDP) method achieves 88.3% area under curve (AUC), considerably outperforming the state-of-the-art baselines. Risk mitigation analysis reveals that targeting the top 1% of predicted high-risk nodes reduces systemic risk exposure by an average of 25%, with heightened efficacy during financial crises and market volatility phases. The proposed method empowers financial regulators and risk managers with enhanced capabilities to monitor and grasp risks embedded within networked-loans against systemic financial crises.
Image }
}

@article{LI20231376,
title = {Bond Default Prediction with Temporal Graph Convolutional Neural Network and Weakly Supervised Learning},
journal = {Procedia Computer Science},
volume = {221},
pages = {1376-1385},
year = {2023},
note = {Tenth International Conference on Information Technology and Quantitative Management (ITQM 2023)},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2023.08.128},
url = {https://www.sciencedirect.com/science/article/pii/S1877050923008864},
author = {Yuyong Li and Zhaorui Wang and Fan Meng},
keywords = {Bond default prediction, Temporal graph neural networks, PSVM, Weakly supervised learning},
abstract = {Bond defaults prediction is an important task in financial market. Many researchers have also tried to use machine learning methods for bond default prediction in recent years, but the existing methods are threatened by the class imbalance problem, and frequent change of market conditions. In this paper, we propose a framework for bond default prediction based on weakly supervised learning method that could solve the problems. Firstly, the risk feature data of bonds are embedded through a supervised model based on a temporal deep learning method and graph neural network. Secondly, based on the obtained embedding vector, combined with a reasonable estimate of the current bond market, a weakly supervised learning approach is used to perform bond default prediction. The model can make use of both bond-related information and market-related information, which significantly improves the effectiveness. In the experimental results on a real dataset from the Chinese bond market, when predicting defaulted bonds, our study achieved a recall of 0.83, a precision of 0.65, and an F1 score of 0.72, outperforming existing models.}
}

