{
  "artifacts_dir": "artifacts/mvp/baseline",
  "data": {
    "features_glob": "data/parquet/raw/data_*.parquet",
    "id_column": "customer_ID",
    "labels_path": "data/parquet/raw/train_labels.parquet",
    "sample_customers": 10000,
    "target_column": "target",
    "time_column": "S_2"
  },
  "evaluation": {
    "ece_bins": 10
  },
  "model": {
    "learning_rate": 0.05,
    "max_depth": -1,
    "n_estimators": 250,
    "n_jobs": 4,
    "num_leaves": 31
  },
  "seed": 42,
  "split": {
    "test_fraction": 0.2,
    "train_fraction": 0.64,
    "validation_fraction": 0.16
  }
}
